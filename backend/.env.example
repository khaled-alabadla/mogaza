# Copy to backend/.env and fill in real values. Never commit the real .env.

# --- Django ---
# Set to True only on a developer machine.
DJANGO_DEBUG=False
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_ALLOWED_HOSTS=locations.example.gov.ps,localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Gaza
DJANGO_LOG_LEVEL=INFO

# --- PostgreSQL (the permanent database) ---
POSTGRES_DB=gaza_locations
POSTGRES_USER=gaza_locations
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60
# Hosted PostgreSQL (e.g. on Vercel): one URL instead of the POSTGRES_* values above. Wins when set.
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
# Share the login throttle between workers / serverless instances (run `manage.py createcachetable` once).
# DJANGO_CACHE_TABLE=django_cache

# --- Frontend origins (dev server / production domain) ---
CSRF_TRUSTED_ORIGINS=https://locations.example.gov.ps,http://localhost:5173
CORS_ALLOWED_ORIGINS=https://locations.example.gov.ps,http://localhost:5173

# --- Behaviour ---
# Allow visitors that are not logged in to search (they can never add/edit/delete).
PUBLIC_SEARCH_ENABLED=False
LOGIN_THROTTLE_RATE=10/min
# Reverse proxies in front of gunicorn that append the client address to X-Forwarded-For
# (nginx: proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;). 0 = use the TCP peer address.
NUM_PROXIES=0
# Session lifetime in seconds (default 10 hours)
SESSION_COOKIE_AGE=36000

# --- HTTPS hardening (active when DJANGO_DEBUG=False) ---
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000

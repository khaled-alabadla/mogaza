# Example nginx site for production.
# The React build and the Django API are served from ONE origin, so the session
# cookie and CSRF protection work without cross-site requests.

upstream gaza_locations_api {
    server 127.0.0.1:8000;   # gunicorn config.wsgi:application --bind 127.0.0.1:8000
}

server {
    listen 80;
    server_name locations.example.gov.ps;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name locations.example.gov.ps;

    ssl_certificate     /etc/ssl/certs/locations.crt;
    ssl_certificate_key /etc/ssl/private/locations.key;

    client_max_body_size 1m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;

    # React production build (frontend/dist)
    root /srv/gaza-locations/frontend/dist;
    index index.html;

    location /api/ {
        proxy_pass http://gaza_locations_api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /django-admin/ {
        proxy_pass http://gaza_locations_api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Django admin static files (python manage.py collectstatic)
    location /static/ {
        alias /srv/gaza-locations/backend/staticfiles/;
    }

    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # Single-page app: unknown paths fall back to index.html
    location / {
        try_files $uri /index.html;
    }
}
